<?xml version="1.0" encoding="UTF-8"?>
<!-- The payment term is a default that companies adapt to their needs, so it
     must not be reset on every module update. -->
<odoo noupdate="1">
    <record id="payment_term_event_20_80_90" model="account.payment.term">
        <!-- base language -->
        <field name="name">20% now, balance 90 days before event</field>
        <field name="note">20% at booking, balance 90 days before the event</field>

        <field name="line_ids"
            eval="[
            Command.clear(),
            Command.create({
                'value': 'percent',
                'value_amount': 20.0,
                'nb_days': 0,
            }),
            Command.create({
                'value': 'percent',
                'value_amount': 80.0,
                'nb_days': -90,
                'delay_type': 'rya_days_after_event',
            }),
        ]" />
    </record>

    <record id="payment_term_event_20_80_start" model="account.payment.term">
        <!-- base language -->
        <field name="name">20% now, balance before event</field>
        <field name="note">20% at booking, balance before the event</field>

        <field name="line_ids"
            eval="[
            Command.clear(),
            Command.create({
                'value': 'percent',
                'value_amount': 20.0,
                'nb_days': 0,
            }),
            Command.create({
                'value': 'percent',
                'value_amount': 80.0,
                'nb_days': 0,
                'delay_type': 'rya_days_after_event',
            }),
        ]" />
    </record>
</odoo>