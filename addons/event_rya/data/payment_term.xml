<?xml version="1.0" encoding="UTF-8"?>
<!-- The payment term is a default that companies adapt to their needs, so it
     must not be reset on every module update. -->
<odoo noupdate="1">
    <record id="payment_term_event_20_30_50" model="account.payment.term">
        <!-- base language -->
        <field name="name">20% now, 30% 120 days, 50% 60 days before event</field>
        <field name="note">20% at booking, 30% 120 days, 50% 60 days before event</field>

        <field name="line_ids"
            eval="[
            Command.clear(),
            Command.create({
                'value': 'percent',
                'value_amount': 20.0,
                'nb_days': 0,
            }),
            Command.create({
                'value': 'percent',
                'value_amount': 30.0,
                'nb_days': -120,
                'delay_type': 'rya_days_after_event',
            }),
            Command.create({
                'value': 'percent',
                'value_amount': 50.0,
                'nb_days': -60,
                'delay_type': 'rya_days_after_event',
            }),

        ]" />
    </record>

</odoo>