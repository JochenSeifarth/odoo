#. module: event_rya
#: model:mail.template,subject:event_rya.event_mail_template_review_google
msgid "Thank you for spending the day with us!"
msgstr "Спасибо, что провели этот день с нами!"

#. module: event_rya
#: model:mail.template,body_html:event_rya.event_mail_template_review_google
#. module: event_rya
#: model:mail.template,body_html:event_rya.event_mail_template_review_google
msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n"
"                    style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"                    <tr>\n"
"                        <td align=\"center\">\n"
"                            <t t-set=\"review_url\" t-value=\"object.event_id.website_id.rya_google_review_url\" />\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\"\n"
"                                style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"                                <tbody>\n"
"                                    <tr>\n"
"                                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                            <table width=\"590\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n"
"                                                style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                                <tr>\n"
"                                                    <td valign=\"middle\">\n"
"                                                        <span style=\"font-size: 20px; font-weight: bold;\">\n"
"                                                            <t t-out=\"object.event_id.name or ''\" />\n"
"                                                        </span>\n"
"                                                    </td>\n"
"                                                    <td valign=\"middle\" align=\"right\">\n"
"                                                        <t t-set=\"site\"\n"
"                                                            t-value=\"object.event_id.website_id or object.env.ref('website.default_website', raise_if_not_found=False)\" />\n"
"                                                        <img t-if=\"site and site.logo\"\n"
"                                                            t-att-src=\"'/web/image/website/%s/logo' % site.id\"\n"
"                                                            style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\"\n"
"                                                            t-att-alt=\"site.name\" />\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                                <tr>\n"
"                                                    <td colspan=\"2\" style=\"text-align:center;\">\n"
"                                                        <hr width=\"100%\"\n"
"                                                            style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;\" />\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                            <table width=\"590\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n"
"                                                style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                                <tr>\n"
"                                                    <td valign=\"top\" style=\"font-size: 14px;\">\n"
"                                                        <div> Dear <t t-out=\"object.name or ''\" />,<br /><br /> thank you very much\n"
"                                                            for spending a day fishing with us in Alicante! We hope you had a great\n"
"                                                            time aboard our PEIXET and that you were completely satisfied with your\n"
"                                                            fishing experience. </div>\n"
"                                                        <br />\n"
"                                                        <div>\n"
"                                                            Your opinion is very important to us. If you have any comments, ideas or\n"
"                                                            suggestions, please feel free to contact us at any time. We really\n"
"                                                            appreciate your feedback and are always looking for ways to make our\n"
"                                                            trips even better.\n"
"                                                        </div>\n"
"                                                        <t t-if=\"review_url\">\n"
"                                                            <br />\n"
"                                                            <div>\n"
"                                                                You would also help us a lot by leaving us a Google review. If you\n"
"                                                                enjoyed your trip, we would be very happy if you shared your\n"
"                                                                experience with other guests. You can leave a review directly using\n"
"                                                                this link:</div>\n"
"                                                            <br />\n"
"                                                            <div style=\"text-align:center;\">\n"
"                                                                <a t-att-href=\"review_url\" target=\"_blank\"\n"
"                                                                    t-attf-style=\"padding: 8px 12px; font-size: 14px; color: {{object.event_id.company_id.email_primary_color or '#FFFFFF'}}; text-decoration: none !important; font-weight: 400; background-color: {{object.event_id.company_id.email_secondary_color or '#875A7B'}}; border-radius:3px; display: inline-block;\">\n"
"                                                                    Leave a review</a>\n"
"                                                            </div>\n"
"                                                        </t>\n"
"                                                        <br />\n"
"                                                        <div>\n"
"                                                            We would be delighted to welcome you aboard again on your next visit to\n"
"                                                            Alicante!\n"
"                                                        </div>\n"
"                                                        <br />\n"
"                                                        <div> And if you would like to experience the Mediterranean in a different\n"
"                                                            way: we also offer day trips, sailing holidays and special sailing\n"
"                                                            experiences aboard our classic sailing yacht LILLI. You can find out\n"
"                                                            more at <a t-attf-href=\"http://www.real-yachting-alicante.com\"\n"
"                                                                target=\"_blank\"\n"
"                                                                t-attf-style=\"color: {{object.event_id.company_id.email_secondary_color or '#875A7B'}};\">\n"
"                                                            www.real-yachting-alicante.com</a>.</div>\n"
"                                                        <br />\n"
"                                                        <br />\n"
"                                                        <div> Best wishes from Alicante <br />\n"
"                                                        <span style=\"color: #454748;\">Your <a\n"
"                                                                target=\"_blank\"\n"
"                                                                t-attf-href=\"{{ object.event_id.website_id.domain or ' '}}\"\n"
"                                                                t-attf-style=\"color: {{object.event_id.user_id.company_id.email_secondary_color or '#875A7B'}};\"\n"
"                                                                t-out=\"object.event_id.website_id.name or object.company_id.website\">\n"
"                                                            YourWebsite.com\n"
"                                                        </a>\n"
"                                                            Team</span>\n"
"                                                        </div>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                                <tr>\n"
"                                                    <td style=\"text-align:center;\">\n"
"                                                        <hr width=\"100%\"\n"
"                                                            style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\" />\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td align=\"center\"\n"
"                                            style=\"border-radius:0px;border-style:none;padding:0px;margin:0px;box-sizing:border-box;border-left-color:#808080;border-bottom-color:#808080;border-right-color:#808080;border-top-color:#808080;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;min-width: 590px; color: #454748; background-color: #f1f1f1;\">\n"
"                                            <t t-if=\"object.company_id\">\n"
"                                                <table width=\"590\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n"
"                                                    style=\"border-radius: 0px; border-style: none; margin: 0px; box-sizing: border-box; border-color: #808080; border-width: 0px; caption-side: bottom; min-width: 590px; padding: 8px; border-collapse: separate; font-family: Verdana, Arial, sans-serif; color: #454748;\">\n"
"                                                    <tbody\n"
"                                                        style=\"border-radius:0px;border-style:none;padding:0px;margin:0px;box-sizing:border-box;border-left-color:#808080;border-bottom-color:#808080;border-right-color:#808080;border-top-color:#808080;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;\">\n"
"                                                        <tr\n"
"                                                            style=\"border-radius:0px;border-style:none;padding:0px;margin:0px;box-sizing:border-box;border-left-color:#808080;border-bottom-color:#808080;border-right-color:#808080;border-top-color:#808080;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;\">\n"
"                                                            <td\n"
"                                                                style=\"border-radius:0px;border-style:none;padding:0px;margin:0px;box-sizing:border-box;border-left-color:#808080;border-bottom-color:#808080;border-right-color:#808080;border-top-color:#808080;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;text-align: center; font-size: 14px; color: #454748; background-color: #f1f1f1;\">\n"
"                                                                Sent by <a target=\"_blank\"\n"
"                                                                    t-attf-href=\"{{ object.company_id.website }}\"\n"
"                                                                    t-attf-style=\"color: {{object.event_id.user_id.company_id.email_secondary_color or '#875A7B'}};\"\n"
"                                                                    t-out=\"object.company_id.name or ''\"\n"
"                                                                style=\"color: #454748; text-decoration: none; border-radius: 0px; border-style: none; padding: 0px; margin: 0px; box-sizing: border-box; border-color: #008f8c; border-width: 0px;\">\n"
"                                                                 YourCompany</a>\n"
"                                                                <br /> Discover <a href=\"\"\n"
"                                                                    t-attf-href=\"{{ object.company_id.website }}/event\"\n"
"                                                                    t-attf-style=\"color: {{object.event_id.user_id.company_id.email_secondary_color or '#875A7B'}};\">all\n"
"                                                                our events</a>.</td>\n"
"                                                        </tr>\n"
"                                                    </tbody>\n"
"                                                </table>\n"
"                                            </t>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </tbody>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"            "
msgstr ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n"
"                    style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"                    <tr>\n"
"                        <td align=\"center\">\n"
"                            <t t-set=\"review_url\" t-value=\"object.event_id.website_id.rya_google_review_url\" />\n"
