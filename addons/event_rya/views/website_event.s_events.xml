<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Picture Layout RYA -->
    <template id="dynamic_filter_template_event_event_picture_rya"
        inherit_id="website_event.dynamic_filter_template_event_event_picture"
        name="Picture Layout RYA" priority="5">
        <xpath expr="." position="replace">
            <div t-foreach="records" t-as="data" class="s_events_event w-100" data-extra-classes="g-3"
                data-column-classes="col-12 col-sm-6 col-lg-4">
                <t t-set="record" t-value="data['_record']._set_tz_context()" />
                <a
                    class="s_events_event_cover position-relative d-flex align-items-center rounded overflow-hidden text-decoration-none ratio ratio-1x1"
                    t-att-href="data['call_to_action_url']">
                    <t t-call="website.record_cover">
                        <t t-set="_record" t-value="record" />
                        <t t-set="_resize_height" t-value="512" />
                        <t t-set="_resize_width" t-value="512" />
                        <t t-set="use_filters" t-value="True" />
                        <t t-set="additionnal_classes" t-value="'h-100 w-100 bg-600 position-absolute'" />
                    </t>

                    <div class="text-center w-100 h-100 px-3 d-flex flex-column justify-content-center flex-grow-1">
                        <div t-if="is_sample" class="h5 o_ribbon_right bg-primary text-uppercase">Sample</div>
                        <h4 class="text-white" t-field="record.name" />
                        <time t-att-datetime="record.date_begin"
                            class="text-white text-center">
                            <t t-set="seen_times"
                                t-value="[]" />
                            <t t-foreach="record.event_slot_ids.sorted('start_datetime')" t-as="slot">
                                <t
                                    t-if="slot.start_datetime and slot.start_datetime > datetime.datetime.combine(datetime.date.today(), datetime.time.min)">
                                    <t t-set="time_key"
                                        t-value="('%02d:%02d-%02d:%02d' % (
                                        int(slot.start_hour), int((slot.start_hour - int(slot.start_hour)) * 60),
                                        int(slot.end_hour),   int((slot.end_hour   - int(slot.end_hour  )) * 60)))" />
                                    <t t-if="not seen_times or time_key not in seen_times">
                                        <t t-set="seen_times"
                                            t-value="(seen_times or []) + [time_key]" />
                                        <div>
                                            <span t-out="slot.start_datetime"
                                                t-options="{'widget': 'datetime', 'time_only': 'true',                              'format': 'short',
                              'tz_name': record.date_tz}" />
                                            - <span t-out="slot.end_datetime"
                                                t-options="{'widget': 'datetime',
                              'time_only': 'true',
                              'format': 'short',
                              'tz_name': record.date_tz}" />
                                        </div>
                                    </t>
                                </t>
                            </t>
                            <t t-if="seen_times or record.event_slot_ids">
                                <!-- don't show month for daytrips
                            (
                            <span t-out="record.date_begin" t-options="{'widget': 'datetime', 'date_only': 'true', 'format': 'MMMM', 'tz_name':
                            record.date_tz}" />
                            <t  t-if="record.date_begin.month != record.date_end.month"> -
                                    <span t-out="record.date_end" t-options="{'widget': 'datetime', 'date_only': 'true', 'format': 'MMMM', 'tz_name': record.date_tz}"
                            />
                            </t>
                            ) -->
                            </t>
                            <t t-elif="record.date_begin.year &lt; 2098">
                                <t t-set="begin_month"
                                    t-value="record.date_begin.month" />
                            <t t-set="begin_year"
                                    t-value="record.date_begin.year" />

                                   <t t-set="end_month"
                                    t-value="record.date_end.month" />
                                   <t t-set="end_year"
                                    t-value="record.date_end.year" />

                                <!-- BEGIN: nur unterschiedliche Teile vom
							Startdatum -->
                                <span>

                                    <span t-out="record.date_begin"
                                        t-options="{'widget':'datetime','date_only':True,'format':'d','tz_name':record.date_tz}" />

                                    <t t-if="begin_month != end_month">
                                        <span t-out="record.date_begin"
                                            t-options="{'widget':'datetime','date_only':True,'format':'MMMM','tz_name':record.date_tz}" />
                                    </t>
                                    <t t-if="begin_year != end_year">
                                        <span t-out="record.date_begin"
                                            t-options="{'widget':'datetime','date_only':True,'format':'YYYY','tz_name':record.date_tz}" />
                                    </t>
                                </span>
                                - <!-- END: immer komplett das Enddatum -->
                                            <span t-out="record.date_end"
                                    t-options="{'widget':'datetime','date_only':True,'format':'d','tz_name':record.date_tz}" />
                                            <span
                                    t-out="record.date_end"
                                    t-options="{'widget':'datetime','date_only':True,'format':'MMMM','tz_name':record.date_tz}" />
                                            <span
                                    t-out="record.date_end"
                                    t-options="{'widget':'datetime','date_only':True,'format':'y','tz_name':record.date_tz}" />
                            </t>
                        </time>
                        <div class="row text-white justify-content-center w-100">
                            <t t-foreach="record.event_ticket_ids[:3]" t-as="ticket">
                                <!-- show ticket price only if < 99999 -->
                                <div t-if="ticket.price &lt; 99999" class="col-4 text-center">
                                    <h5 class="mt-2 mb-0 text-nowrap">
                                        <t t-out="int(ticket.price)" />
                                        <small t-out="ticket.currency_id.symbol" />
                                    </h5>
                                    <small t-if="ticket.name" t-out="ticket.name" class="d-block lh-1" />
                                </div>
                            </t>
                        </div>
                        <div class="text-white d-flex justify-content-center"
                            t-if="events_event_location_active"
                            t-field="record.address_id"
                            t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': 'true'}" />
                    </div>
                </a>
            </div>
        </xpath>
    </template>
</odoo>