<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_website_form_rya" model="ir.ui.view">
        <field name="name">res.config.settings.form.rya.website</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='google_console_setting']" position="after">
                <setting id="rya_google_review_setting"
                    string="Google Review URL"
                    help="URL to your Google review page.">
                    <field name="rya_google_review_url" placeholder="https://g.page/..." />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>