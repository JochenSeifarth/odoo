<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="website_sale_total_rya" inherit_id="website_sale.total">
        <xpath expr="//tr[@name='o_order_total']" position="after">

            <t t-if="website_sale_order._has_prepayment()">

                <tr name="o_order_prepayment" class="border-top">
                    <td colspan="2" class="border-0 ps-0 pt-1 text-muted"> Anzahlung (<t
                            t-out="website_sale_order.prepayment_percent * 100" /> %) </td>
                    <td class="text-end border-0 px-0 pt-1">
                        <span t-out="website_sale_order._get_prepayment_required_amount()" />
                    </td>
                </tr>

                <tr name="o_order_remaining">
                    <td colspan="2" class="border-0 ps-0 pt-1 text-muted">
                        Restzahlung
                    </td>
                    <td class="text-end border-0 px-0 pt-1">
                        <span
                            t-out="
                        website_sale_order.amount_total
                        - website_sale_order._get_prepayment_required_amount()
                    " />
                    </td>
                </tr>

                <tr name="o_order_amount_due" class="border-top">
                    <td colspan="2" class="border-0 ps-0 pt-2">
                        <strong>Jetzt zu zahlen</strong>
                    </td>
                    <td class="text-end border-0 px-0 pt-2">
                        <strong
                            t-out="
                        website_sale_order._get_prepayment_required_amount()
                    " />
                    </td>
                </tr>

            </t>

        </xpath>

    </template>


    <template id="website_sale_layout_add_organization_id"
        inherit_id="website_sale.website_sale_layout">

        <!-- replace sot ath we can add @id to the Organization schema.org json ld data -->
        <xpath expr="//script[@type='application/ld+json'][@t-if='res_company and website']"
            position="replace">

            <script t-if="res_company and website" type="application/ld+json">
{
    "@context": "http://schema.org",
    "@type":    "Organization",
    "@id":      "<t t-out="res_company.website"/>",
    "name":     "<t t-out="res_company.name"/>",
    "logo":     "<t t-out="'%s/logo.png?company=%s' % (base_url, res_company.id)"/>",
    "url":      "<t t-out="base_url"/>"
}
        </script>

        </xpath>
    </template>
</odoo>