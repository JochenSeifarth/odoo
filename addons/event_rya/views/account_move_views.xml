<odoo>

    <record id="view_move_form_event_participants" model="ir.ui.view">
        <field name="name">account.move.form.event.participants</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                position="after">
                <field name="event_participant_names"
                    string="Attendees"
                    optional="show" />
            </xpath>

        </field>
    </record>

</odoo>