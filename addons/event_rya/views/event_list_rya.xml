<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Show ticket price on Event List Cards -->
    <template id="event_list_rya" inherit_id="website_event.events_list" name="Show Ticket Price on Event Card">
        <!-- Add ticket prices inside each event card, below the title -->
        <xpath expr="//div[@id='event_details']" position="inside">
            <t t-if="event.event_ticket_ids">
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <t t-foreach="event.event_ticket_ids" t-as="ticket">
                        <span class="badge bg-secondary">
                            <t t-if="ticket.name">
                                <t t-out="ticket.name" />: </t>
                            <t t-if="ticket.price &gt;= 99999">
                                On Request
                            </t>
                            <t t-else="">
                                <!-- normale Preisanzeige -->
                                <t t-out="int(ticket.price)" />
                                <t t-out="event.company_id.currency_id.symbol" />
                            </t>
                        </span>
                    </t>

                </div>
            </t>
        </xpath>
        <!-- Hide booking status for "Individuell" events -->
        <xpath expr="//footer[span]" position="replace">
            <t t-if="event.tag_ids.filtered(lambda t: t.name == 'Individuell') and not env.user.has_group('event.group_event_user')">
            </t>
            <t t-else="">
                <!-- the original Odoo logic -->
                <!-- Footer (Grid View) -->
                <footer t-if="not event.event_registrations_open and opt_events_list_columns and opt_events_list_cards"
                    t-att-class="'small align-self-end w-100 %s %s' % (
                        opt_events_list_cards and 'card-footer' or (not opt_events_list_columns and 'py-2 mt-2') or 'py-2',
                        opt_events_list_cards and 'border-top' or 'px-2',
                    )">
                    <span t-if="not event.event_registrations_open">
                        <t t-if="event.kanban_state == 'cancel'">
                            Cancelled
                        </t>
                        <t t-elif="not event.event_registrations_started">
                            Registrations not yet open
                        </t>
                        <t t-elif="event.event_registrations_sold_out">
                            Sold Out
                        </t>
                        <t t-else="">
                            Registrations Closed
                        </t>
                    </span>
                </footer>
            </t>
        </xpath>
    </template>
</odoo>