<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Show ticket price on Event List Cards -->
    <template id="event_list_rya" inherit_id="website_event.events_list" name="Show Ticket Price on Event Card">
        <!-- Add ticket prices inside each event card, below the title -->
        <xpath expr="//div[@id='event_details']" position="inside">
            <t t-if="event.event_ticket_ids">
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <t t-foreach="event.event_ticket_ids" t-as="ticket">
                        <span class="badge bg-secondary">
                            <t t-if="ticket.name">
                                <t t-out="ticket.name" />: </t>
                            <t t-if="ticket.price &gt;= 99999">
                                On Request
                            </t>
                            <t t-else="">
                                <!-- normale Preisanzeige -->
                                <t t-out="int(ticket.price)" />
                                <t t-out="event.company_id.currency_id.symbol" />
                            </t>
                        </span>
                    </t>

                </div>
            </t>
        </xpath>

        <!-- Hide booking status for "Individuell" events -->
        <xpath expr="//footer[span]" position="replace">
            <t t-if="event.tag_ids.filtered(lambda t: t.id in [5, 10]) and not env.user.has_group('event.group_event_user')">
            </t>
            <t t-else="">
                <!-- the original Odoo logic -->
                <!-- Footer (Grid View) -->
                <footer t-if="not event.event_registrations_open and opt_events_list_columns and opt_events_list_cards"
                    t-att-class="'small align-self-end w-100 %s %s' % (
                        opt_events_list_cards and 'card-footer' or (not opt_events_list_columns and 'py-2 mt-2') or 'py-2',
                        opt_events_list_cards and 'border-top' or 'px-2',
                    )">
                    <span t-if="not event.event_registrations_open">
                        <t t-if="event.kanban_state == 'cancel'">
                            Cancelled
                        </t>
                        <t t-elif="not event.event_registrations_started">
                            Registrations not yet open
                        </t>
                        <t t-elif="event.event_registrations_sold_out">
                            Sold Out
                        </t>
                        <t t-else="">
                            Registrations Closed
                        </t>
                    </span>
                </footer>
            </t>
        </xpath>

        <!-- Event card width: col-xl-3 -> col-xl-4 -->
        <xpath expr="//t[@t-set='opt_event_size' and contains(@t-value, 'col-xl-3')]" position="attributes">
            <attribute name="t-value">opt_index_sidebar and 'col-md-6' or 'col-md-6 col-lg-4 col-xl-4'</attribute>
        </xpath>

        <!-- Remove JSON-LD / Microdata attributes -->
        <xpath expr="//article[@itemscope='itemscope']" position="attributes">
            <attribute name="itemscope" />
            <attribute name="itemtype" />
        </xpath>

        <xpath expr="//meta[@itemprop='startDate']" position="attributes">
            <attribute name="itemprop" />
        </xpath>

        <xpath expr="//span[@t-field='event.name' and @itemprop='name']" position="attributes">
            <attribute name="itemprop" />
        </xpath>

        <xpath expr="//small[@itemprop='location']" position="attributes">
            <attribute name="itemprop" />
        </xpath>

        <xpath expr="//small[@t-field='event.subtitle' and @itemprop='description']" position="attributes">
            <attribute name="itemprop" />
        </xpath>

        <xpath expr="//small[@t-if='opt_events_list_columns' and @itemprop='location']" position="attributes">
            <attribute name="itemprop" />
        </xpath>

        <!-- Single-slot date: day above month, without leading zero -->
        <xpath
            expr="//div[@t-if='not event.is_multi_slots' and contains(@class, 'o_wevent_event_date_text')]/span[contains(@class, 'o_wevent_event_day')]"
            position="replace" />

        <xpath
            expr="//div[@t-if='not event.is_multi_slots' and contains(@class, 'o_wevent_event_date_text')]/span[contains(@class, 'o_wevent_event_month')]"
            position="before">
            <span t-out="event.date_begin"
                t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'd'}"
                class="o_wevent_event_day oe_hide_on_date_edit" />
        </xpath>

        <xpath expr="//div[@t-elif='not event.is_multi_slots']/span[contains(@class, 'o_wevent_event_day')]" position="replace" />

        <xpath expr="//div[@t-elif='not event.is_multi_slots']/span[contains(@class, 'o_wevent_event_month')]" position="before">
            <span t-out="event.date_begin"
                t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'd'}"
                class="o_wevent_event_day oe_hide_on_date_edit" />
        </xpath>

        <!-- Multi-slot events: show distinct starting times -->
        <xpath expr="//div[@t-elif='not event.is_multi_slots']" position="after">
            <div t-elif="event.is_multi_slots and event.event_slot_ids and not event.tag_ids.filtered(lambda t: t.id in [5, 10])"
                t-attf-class="o_wevent_event_date position-absolute shadow-sm o_not_editable #{(not opt_events_list_columns) and 'left'} ">
                <t t-set="seen_times" t-value="[]" />
                <t t-set="first" t-value="True" />
                <t t-foreach="event.event_slot_ids.sorted('start_datetime')" t-as="slot" t-last="last">
                    <t t-set="time_key"
                        t-value="('%02d:%02d-%02d:%02d' % (
                           int(slot.start_hour),
                           int((slot.start_hour - int(slot.start_hour)) * 60),
                           int(slot.end_hour),
                           int((slot.end_hour - int(slot.end_hour)) * 60)
                       ))" />
                    <t t-if="not seen_times or time_key not in seen_times">
                        <t t-set="seen_times" t-value="(seen_times or []) + [time_key]" />
                        <div>
                            <t t-if="not first">
                                <div style="text-align:center; line-height:1; margin:0;">&amp;</div>
                            </t>
                            <span t-out="slot.start_datetime"
                                t-options="{'widget': 'datetime', 'time_only': 'true', 'format': 'short', 'tz_name': event.date_tz}" />
                            <t t-set="first" t-value="False" />
                        </div>
                    </t>
                </t>
            </div>
        </xpath>

    </template>
</odoo>