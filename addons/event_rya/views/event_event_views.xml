<?xml version="1.0"?>
<odoo>
	<data>
		<record id="view_event_event_form_inherit_payment_term" model="ir.ui.view">
			<field name="name">event.event.form.payment.term.inherit</field>
			<field name="model">event.event</field>
			<field name="inherit_id" ref="event.view_event_form" />
			<field name="arch" type="xml">
				<xpath expr="//field[@name='event_type_id']" position="after">
					<field name="payment_term_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" />
				</xpath>
			</field>
		</record>

		<record id="view_event_event_form_inherit_legs" model="ir.ui.view">
			<field name="name">event.event.form.legs.inherit</field>
			<field name="model">event.event</field>
			<field name="inherit_id" ref="event.view_event_form" />
			<field name="arch" type="xml">
				<xpath expr="//notebook" position="inside">
					<page string="Legs" name="event_legs">
						<group class="oe_title">
							<label for="total_distance_nm" string="Total Distance [nm]: " />
							<div class="d-flex">
								<field name="total_distance_nm" readonly="1" />
							</div>
						</group>
						<field name="event_leg_ids">
							<list string="Legs" editable="bottom" default_order="sequence">
								<field name="sequence" widget="handle" />
								<field name="address_id" />
								<field name="partner_latitude" widget="latitude_dms" />
								<field name="partner_longitude" widget="longitude_dms" />
								<field name="distance_from_prev_nm" />
							</list>
						</field>
					</page>
				</xpath>
			</field>
		</record>

		<record id="view_event_event_form_inherit_mail_slot_scope" model="ir.ui.view">
			<field name="name">event.event.form.mail.slot.scope.inherit</field>
			<field name="model">event.event</field>
			<field name="inherit_id" ref="event.view_event_form" />
			<field name="arch" type="xml">
				<xpath expr="//page[@name='event_communication']//field[@name='interval_type']" position="after">
					<field name="only_attendees" invisible="interval_type in ('before_event', 'after_sub')"
						title="Send only to the participants that actually attended." />
				</xpath>
			</field>
		</record>

		<record id="view_event_event_form_inherit_run_communications" model="ir.ui.view">
			<field name="name">event.event.form.run.communications.inherit</field>
			<field name="model">event.event</field>
			<field name="inherit_id" ref="event.view_event_form" />
			<field name="arch" type="xml">
				<xpath expr="//page[@name='event_communication']/field[@name='event_mail_ids']" position="before">
					<button name="action_run_mail_schedulers" type="object"
						string="Send the communications that are due now"
						class="btn btn-secondary mb-2"
						groups="base.group_no_one"
						confirm="This sends the emails of this event whose scheduled date are reached. Continue?" />
				</xpath>
			</field>
		</record>
	</data>
</odoo>